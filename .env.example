# Application Port (default: 3000 on macOS to avoid AirPlay conflict on 5000)
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL / Neon Database URL
# If you have a Neon or PostgreSQL database, paste your connection string here.
# For sandbox / mock frontend testing, a placeholder URL is sufficient.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thepot

# N8N Webhook URL (for AI Pot creation)
N8N_WEBHOOK_URL=https://nexark.app.n8n.cloud/webhook/80b7af49-9eca-4f78-b8df-6154b1c641db

# Stripe Configuration (Test Mode)
# Replace with your actual Stripe API keys from dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_51MockTestKeyForStripeIntegrationThePotUnlimited001
STRIPE_PUBLISHABLE_KEY=pk_test_51MockTestPublishableKeyThePotUnlimited001
STRIPE_WEBHOOK_SECRET=whsec_mock_webhook_secret_for_local_testing_2026
STRIPE_CONNECT_CLIENT_ID=ca_mock_connect_client_id_thepot
STRIPE_API_VERSION=2024-12-18.acacia

# Unit Financial Infrastructure (Sandbox - Primary)
UNIT_API_URL=https://api.s.unit.sh
UNIT_API_TOKEN=your_unit_sandbox_api_token_here
UNIT_WEBHOOK_SECRET=unit_sandbox_webhook_secret_thepot_2026

# Moov Financial Infrastructure (Primary Gateway & Wallets)
# Obtain these from Moov Dashboard -> Developers -> API Keys
MOOV_PUBLIC_KEY=your_moov_public_key_here
MOOV_SECRET_KEY=your_moov_secret_key_here
MOOV_ACCOUNT_ID=your_moov_facilitator_account_id_here
MOOV_WEBHOOK_SECRET=your_moov_webhook_signing_secret_here
MOOV_PAYMENTS_ENABLED=true
MOOV_MOCK_MODE=false

# Feature Flags
UNIT_PAYMENTS_ENABLED=false
UNIT_ACH_ENABLED=false
UNIT_BOOK_PAYMENTS_ENABLED=false
UNIT_WITHDRAWALS_ENABLED=false
STRIPE_PAYMENTS_ENABLED=true

